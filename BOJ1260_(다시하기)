import java.io.*;
import java.util.*;
//다시풀기
public class Main{
    public static List<ArrayList<Integer>>list = new ArrayList<>();
    public static List<Boolean>visited = new ArrayList<>();
    public static void main(String[] args)throws IOException{
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        //BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        StringTokenizer st = new StringTokenizer(br.readLine()," ");

        int N = Integer.parseInt(st.nextToken());
        int M = Integer.parseInt(st.nextToken());
        int V = Integer.parseInt(st.nextToken());



        for(int i = 0; i<N+1; i++){
            list.add(new ArrayList<Integer>());
            visited.add(false);
        }
        for(int i = 0; i<M; i++){
            st=new StringTokenizer(br.readLine()," ");
            int s = Integer.parseInt(st.nextToken());
            int e = Integer.parseInt(st.nextToken());
            list.get(s).add(e);
            list.get(e).add(s);
        }
        for(int i = 1; i<N+1; i++){
            Collections.sort(list.get(i));
        }
        DFS(V);
        Collections.fill(visited,false);
        System.out.println();
        BFS(V);
    }
    public static void DFS(int node){
        System.out.print(node+" ");
        visited.set(node,true);

        for(int i = 0; i<list.get(node).size(); i++){
            int nextNode=list.get(node).get(i);
            if(!visited.get(nextNode)){
                DFS(nextNode);
            }
        }

    }
    public static void BFS(int node){
        ArrayDeque<Integer>queue = new ArrayDeque<>();
        queue.offer(node);
        visited.set(node,true);
        while(!queue.isEmpty()){
            int nowNode = queue.poll();
            System.out.print(nowNode+" ");
            for(int i = 0; i<list.get(nowNode).size(); i++){
                int nextNode=list.get(nowNode).get(i);
                if(!visited.get(nextNode)){
                    queue.offer(nextNode);
                    visited.set(nextNode,true);
                }
            }
        }
    }
}
